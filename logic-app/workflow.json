{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "subscriptionId": {
      "type": "String",
      "metadata": {
        "description": "The Azure subscription ID to query for Advisor recommendations"
      }
    },
    "storageAccountName": {
      "type": "String",
      "metadata": {
        "description": "Name of the storage account for CSV output"
      }
    },
    "containerName": {
      "type": "String",
      "defaultValue": "advisor-recommendations",
      "metadata": {
        "description": "Storage container name for Advisor data"
      }
    }
  },
  "triggers": {
    "DailySchedule": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "UTC",
        "startTime": "2024-01-01T06:00:00Z"
      },
      "metadata": {
        "description": "Runs daily at 6:00 AM UTC to collect Azure Advisor recommendations"
      }
    }
  },
  "actions": {
    "Initialize_CurrentDate": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "CurrentDate",
            "type": "String",
            "value": "@{formatDateTime(utcNow(), 'yyyy-MM-dd')}"
          }
        ]
      },
      "runAfter": {},
      "metadata": {
        "description": "Initialize variable to store current date for file naming"
      }
    },
    "Initialize_CSVContent": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "CSVContent",
            "type": "String",
            "value": "SubscriptionId,ResourceGroup,ResourceName,ResourceType,RecommendationId,Category,Impact,ShortDescription,Description,RecommendationText,LastUpdated,SuppressionIds\\n"
          }
        ]
      },
      "runAfter": {
        "Initialize_CurrentDate": [
          "Succeeded"
        ]
      },
      "metadata": {
        "description": "Initialize CSV header row for Advisor recommendations data"
      }
    },
    "Get_Advisor_Recommendations": {
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "https://management.azure.com/subscriptions/@{parameters('subscriptionId')}/providers/Microsoft.Advisor/recommendations",
        "queries": {
          "api-version": "2020-01-01"
        },
        "authentication": {
          "type": "ManagedServiceIdentity"
        }
      },
      "runAfter": {
        "Initialize_CSVContent": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "contentTransfer": {
          "transferMode": "Chunked"
        }
      },
      "metadata": {
        "description": "Query Azure Advisor API for all current recommendations using managed identity authentication"
      }
    },
    "Parse_Advisor_Response": {
      "type": "ParseJson",
      "inputs": {
        "content": "@body('Get_Advisor_Recommendations')",
        "schema": {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "properties": {
                    "type": "object",
                    "properties": {
                      "category": {
                        "type": "string"
                      },
                      "impact": {
                        "type": "string"
                      },
                      "impactedField": {
                        "type": "string"
                      },
                      "impactedValue": {
                        "type": "string"
                      },
                      "lastUpdated": {
                        "type": "string"
                      },
                      "recommendationTypeId": {
                        "type": "string"
                      },
                      "shortDescription": {
                        "type": "object",
                        "properties": {
                          "problem": {
                            "type": "string"
                          },
                          "solution": {
                            "type": "string"
                          }
                        }
                      },
                      "suppressionIds": {
                        "type": "array"
                      },
                      "extendedProperties": {
                        "type": "object"
                      },
                      "resourceMetadata": {
                        "type": "object",
                        "properties": {
                          "resourceId": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "runAfter": {
        "Get_Advisor_Recommendations": [
          "Succeeded"
        ]
      },
      "metadata": {
        "description": "Parse the JSON response from Azure Advisor API"
      }
    },
    "Process_Recommendations": {
      "type": "Foreach",
      "foreach": "@body('Parse_Advisor_Response')?['value']",
      "actions": {
        "Extract_Resource_Details": {
          "type": "Compose",
          "inputs": {
            "resourceId": "@item()?['properties']?['resourceMetadata']?['resourceId']",
            "resourceGroup": "@if(contains(item()?['properties']?['resourceMetadata']?['resourceId'], '/resourceGroups/'), split(item()?['properties']?['resourceMetadata']?['resourceId'], '/resourceGroups/')[1], split(split(item()?['properties']?['resourceMetadata']?['resourceId'], '/resourceGroups/')[1], '/')[0], 'N/A')",
            "resourceName": "@last(split(item()?['properties']?['resourceMetadata']?['resourceId'], '/'))",
            "resourceType": "@if(contains(item()?['properties']?['resourceMetadata']?['resourceId'], '/providers/'), concat(split(item()?['properties']?['resourceMetadata']?['resourceId'], '/providers/')[1], if(contains(split(item()?['properties']?['resourceMetadata']?['resourceId'], '/providers/')[1], '/'), substring(split(item()?['properties']?['resourceMetadata']?['resourceId'], '/providers/')[1], 0, add(indexOf(split(item()?['properties']?['resourceMetadata']?['resourceId'], '/providers/')[1], '/', 0), 1)), '')), 'N/A')"
          },
          "runAfter": {}
        },
        "Append_CSV_Row": {
          "type": "AppendToStringVariable",
          "inputs": {
            "name": "CSVContent",
            "value": "\"@{parameters('subscriptionId')}\",\"@{outputs('Extract_Resource_Details')?['resourceGroup']}\",\"@{outputs('Extract_Resource_Details')?['resourceName']}\",\"@{outputs('Extract_Resource_Details')?['resourceType']}\",\"@{item()?['name']}\",\"@{item()?['properties']?['category']}\",\"@{item()?['properties']?['impact']}\",\"@{replace(item()?['properties']?['shortDescription']?['problem'], '\"', '\"\"')}\",\"@{replace(item()?['properties']?['shortDescription']?['solution'], '\"', '\"\"')}\",\"@{replace(item()?['properties']?['shortDescription']?['solution'], '\"', '\"\"')}\",\"@{item()?['properties']?['lastUpdated']}\",\"@{join(item()?['properties']?['suppressionIds'], ';')}\"\\n"
          },
          "runAfter": {
            "Extract_Resource_Details": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Parse_Advisor_Response": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 50
        }
      },
      "metadata": {
        "description": "Process each recommendation and build CSV content"
      }
    },
    "Create_Blob": {
      "type": "Http",
      "inputs": {
        "method": "PUT",
        "uri": "https://@{parameters('storageAccountName')}.blob.core.windows.net/@{parameters('containerName')}/advisor-recommendations-@{variables('CurrentDate')}.csv",
        "headers": {
          "x-ms-blob-type": "BlockBlob",
          "Content-Type": "text/csv",
          "x-ms-version": "2020-10-02"
        },
        "body": "@variables('CSVContent')",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://storage.azure.com/"
        }
      },
      "runAfter": {
        "Process_Recommendations": [
          "Succeeded"
        ]
      },
      "metadata": {
        "description": "Upload CSV file to Azure Storage using managed identity authentication"
      }
    },
    "Log_Success": {
      "type": "Compose",
      "inputs": {
        "status": "Success",
        "message": "Azure Advisor recommendations successfully collected and stored",
        "fileName": "advisor-recommendations-@{variables('CurrentDate')}.csv",
        "recommendationsCount": "@length(body('Parse_Advisor_Response')?['value'])",
        "timestamp": "@utcNow()"
      },
      "runAfter": {
        "Create_Blob": [
          "Succeeded"
        ]
      },
      "metadata": {
        "description": "Log successful completion with summary information"
      }
    }
  },
  "outputs": {
    "result": {
      "type": "Object",
      "value": "@outputs('Log_Success')"
    }
  }
}